# Local stack only; get the local publishable/anon key from `supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
APP_ORIGIN=http://localhost:3000
# 2026 does not require SUPABASE_SERVICE_ROLE_KEY or SESSION_SECRET.
# Never share a production database with Vercel Preview.
